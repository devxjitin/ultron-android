{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://devxjitin.dev/contracts/remote-config.schema.json",
  "title": "Ultron Remote Config values",
  "description": "Every key the app reads from Firebase Remote Config. Values arrive as strings, so JSON values are encoded text.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "min_supported_version": { "type": "integer", "minimum": 0, "default": 0 },
    "live_model_default": { "type": "string", "minLength": 1, "default": "gemini-3.8-live" },
    "live_models_allowed": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "label"],
        "additionalProperties": false,
        "properties": { "id": { "type": "string", "minLength": 1 }, "label": { "type": "string", "minLength": 1 } }
      }
    },
    "session_max_minutes": { "type": "integer", "minimum": 1, "maximum": 60, "default": 15 },
    "idle_timeout_seconds": { "type": "integer", "minimum": 10, "maximum": 1800, "default": 120 },
    "turn_timeout_seconds": { "type": "integer", "minimum": 5, "maximum": 120, "default": 15 },
    "max_tool_result_chars": { "type": "integer", "minimum": 500, "maximum": 50000, "default": 6000 },
    "update_check_minutes": { "type": "integer", "minimum": 1, "maximum": 1440, "default": 5 },
    "tools_disabled": { "type": "array", "items": { "type": "string", "minLength": 1 }, "default": [] },
    "prompt_version": { "type": "string", "default": "" },
    "skills_version": { "type": "string", "default": "" }
  }
}
