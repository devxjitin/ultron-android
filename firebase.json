{
  "firestore": { "rules": "firestore.rules" },
  "hosting": {
    "site": "ultron-control",
    "public": "web",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "headers": [
      { "source": "**", "headers": [
        { "key": "Cache-Control", "value": "no-cache" },
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ] }
    ]
  }
}
