rules_version = '2';
// The app keeps no data in Firestore: prompts, skills and connectors ship inside the APK, and subscriptions live in
// DynamoDB behind the Ultron API. Everything here stays closed.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
