rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Only the owner can edit what the app reads; the text is bundled in the APK anyway, so reads are open.
    function isOwner() {
      return request.auth != null
        && request.auth.token.email == 'devxjitin@gmail.com'
        && request.auth.token.email_verified == true;
    }
    function short(field, max) {
      return !(field in request.resource.data)
        || (request.resource.data[field] is string && request.resource.data[field].size() <= max);
    }
    function validBuild() {
      return !('minAppVersion' in request.resource.data)
        || (request.resource.data.minAppVersion is int && request.resource.data.minAppVersion >= 0);
    }

    match /remote/prompts {
      allow read: if true;
      allow delete: if isOwner();
      allow create, update: if isOwner()
        && request.resource.data.keys().hasOnly(['persona', 'policy', 'greeting', 'documentFormatPrompt',
                                                 'retrievalChunkLimit', 'minAppVersion', 'updatedAt'])
        && validBuild()
        && short('persona', 20000) && short('policy', 12000)
        && short('greeting', 60) && short('documentFormatPrompt', 10000)
        && (!('retrievalChunkLimit' in request.resource.data)
            || (request.resource.data.retrievalChunkLimit is int
                && request.resource.data.retrievalChunkLimit >= 1
                && request.resource.data.retrievalChunkLimit <= 15));
    }

    match /remote_skills/{name} {
      allow read: if true;
      allow delete: if isOwner();
      allow create, update: if isOwner()
        && name.matches('[a-z0-9][a-z0-9_-]{0,47}')
        && name != 'ultron-features'
        && request.resource.data.keys().hasOnly(['description', 'body', 'published', 'tasks', 'minAppVersion', 'updatedAt'])
        && validBuild()
        && (!('published' in request.resource.data) || request.resource.data.published is bool)
        && (!('tasks' in request.resource.data)
            || (request.resource.data.tasks is map && request.resource.data.tasks.size() <= 20))
        && short('description', 300) && short('body', 8000);
    }

    match /{other=**} {
      allow read, write: if false;
    }
  }
}
